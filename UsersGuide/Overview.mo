within ScenarioLibrary.UsersGuide;
class Overview "Scope and package organisation"
  extends Modelica.Icons.Information;
  annotation(Documentation(info="<html><p>ScenarioLibrary defines deterministic initial conditions, planned inputs, environmental assumptions and timing in Modelica. Records carry initial values, signal blocks generate commands and selected models supply physical boundary conditions.</p><p>Choose Initialization for state data, Profiles and Operating for trajectories, Environment for boundary assumptions and Timing for phases, windows and clocks. Examples show how these components are bound or connected to a model.</p></html>"));
end Overview;
