within ScenarioLibrary;
package Examples "Complete examples of scenario configuration"
  extends Modelica.Icons.ExamplesPackage;
  annotation(Documentation(info="<html><p>Eight examples demonstrate initial-state bindings, planned profiles, environmental inputs, phase windows, event counts and reusable scenarios. Each includes its sources, connections and experiment settings.</p><p>Begin with <a href=\"modelica://ScenarioLibrary.Examples.MultiphaseMission\">MultiphaseMission</a>, then select the example for the required interface.</p></html>"));
end Examples;
